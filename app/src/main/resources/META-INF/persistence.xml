<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="pms" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.clinic.pms.entity.DoctorCredential</class>
    <class>com.clinic.pms.entity.DoctorClinicProfile</class>
    <class>com.clinic.pms.entity.BackupMetadata</class>
    <class>com.clinic.pms.entity.Patient</class>
    <class>com.clinic.pms.entity.MedicalHistoryEntry</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <!-- jdbc.url/user/password are supplied at runtime by PersistenceConfig
           (data file path depends on the user's home directory). -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      <!-- Schema is managed exclusively by Flyway (constitution Principle IV) — never by Hibernate. -->
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
