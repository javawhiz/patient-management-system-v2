<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.clinic.pms.view.PatientProfileController"
            fitToWidth="true"
            fitToHeight="true">
    <BorderPane>
        <top>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="15" right="15" bottom="10" left="15"/>
                </padding>
                <Label fx:id="titleLabel" styleClass="page-title" text="Patient Profile"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Print" styleClass="button-print" onAction="#handlePrint"/>
                <Button text="Delete" styleClass="button-delete" onAction="#handleDelete"/>
                <Button text="Back to Patients" styleClass="button-cancel" onAction="#handleBack"/>
            </HBox>
        </top>

        <center>
            <TabPane>
                <Tab text="Details" closable="false">
                    <VBox spacing="8">
                        <padding>
                            <Insets top="10" right="15" bottom="10" left="15"/>
                        </padding>

                        <GridPane hgap="10" vgap="8">
                            <Label text="Full name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Date of birth" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="dobPicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Gender" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <ChoiceBox fx:id="genderField" prefWidth="180.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Phone" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Email" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="emailField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Address" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <TextArea fx:id="addressField" prefRowCount="4" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Emergency contact" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                            <TextField fx:id="emergencyContactField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Button text="Save Changes" styleClass="button-primary" onAction="#handleSave"/>
                    </VBox>
                </Tab>

                <Tab text="Medical History" closable="false">
                    <GridPane hgap="10" vgap="8">
                        <padding>
                            <Insets top="10" right="15" bottom="10" left="15"/>
                        </padding>

                        <rowConstraints>
                            <RowConstraints percentHeight="10"/>
                            <RowConstraints percentHeight="60"/>
                            <RowConstraints percentHeight="40"/>
                        </rowConstraints>
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <GridPane hgap="10" vgap="4">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>

                                <Label text="Date" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label text="Diagnosis" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <DatePicker fx:id="historyDatePicker" promptText="Date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextArea fx:id="historyDiagnosisArea"
                                          styleClass="history-text-area"
                                          promptText="Diagnosis / complaint"
                                          prefRowCount="3"
                                          wrapText="true"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>

                        <GridPane hgap="10"
                                  maxHeight="Infinity"
                                  GridPane.rowIndex="1"
                                  GridPane.columnIndex="0"
                                  GridPane.hgrow="ALWAYS"
                                  GridPane.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="60" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="40" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <VBox spacing="4" maxHeight="Infinity" GridPane.columnIndex="0" GridPane.vgrow="ALWAYS">
                                <Label text="Prescription" styleClass="field-label"/>
                                <TextArea fx:id="historyPrescriptionArea"
                                          styleClass="history-text-area"
                                          promptText="Prescription"
                                          wrapText="true"
                                          maxHeight="Infinity"
                                          VBox.vgrow="ALWAYS"/>
                            </VBox>

                            <GridPane vgap="8" maxHeight="Infinity" GridPane.columnIndex="1" GridPane.vgrow="ALWAYS">
                                <rowConstraints>
                                    <RowConstraints percentHeight="80" vgrow="ALWAYS"/>
                                    <RowConstraints percentHeight="20" vgrow="NEVER"/>
                                </rowConstraints>

                                <VBox spacing="4" maxHeight="Infinity" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
                                    <Label text="Notes" styleClass="field-label"/>
                                    <TextArea fx:id="historyNotesArea"
                                              styleClass="history-text-area"
                                              promptText="Notes"
                                              wrapText="true"
                                              maxHeight="Infinity"
                                              VBox.vgrow="ALWAYS"/>
                                </VBox>

                                <GridPane hgap="16" GridPane.rowIndex="1">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                                        <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Button text="Add Entry"
                                            styleClass="button-success"
                                            onAction="#handleAddHistory"
                                            GridPane.columnIndex="1"
                                            GridPane.halignment="CENTER"/>
                                    <Button text="View Deleted Entries"
                                            styleClass="button-warning"
                                            onAction="#handleViewDeletedHistory"
                                            GridPane.columnIndex="2"
                                            GridPane.halignment="RIGHT"/>
                                </GridPane>
                            </GridPane>
                        </GridPane>

                        <ListView fx:id="historyListView"
                                  styleClass="history-list-view"
                                  fixedCellSize="45"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="0"
                                  GridPane.vgrow="NEVER"/>
                    </GridPane>
                </Tab>
            </TabPane>
        </center>
    </BorderPane>
</ScrollPane>
