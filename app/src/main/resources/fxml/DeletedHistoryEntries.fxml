<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.clinic.pms.view.DeletedHistoryEntriesController">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label styleClass="page-title" text="Deleted History Entries"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Close" styleClass="button-cancel" onAction="#handleClose"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="entryTable">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
                <TableColumn fx:id="diagnosisColumn" text="Diagnosis" prefWidth="260"/>
                <TableColumn fx:id="deletedAtColumn" text="Deleted At" prefWidth="180"/>
                <TableColumn fx:id="restoreColumn" text="" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
