<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.clinic.pms.view.PatientListController">
    <top>
        <VBox spacing="10">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label styleClass="page-title" text="Patients"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Deleted Patients" styleClass="button-open" onAction="#handleOpenDeleted"/>
                <Button text="Backup &amp; Restore" styleClass="button-backup" onAction="#handleOpenBackupRestore"/>
                <Button text="Log Out" styleClass="button-cancel" onAction="#handleLogout"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="landing-filter-bar">
                <TextField fx:id="queryField" promptText="Search by name"/>
                <TextField fx:id="phoneField" promptText="Phone number"/>
                <Label text="From"/>
                <DatePicker fx:id="fromDatePicker"/>
                <Label text="To"/>
                <DatePicker fx:id="toDatePicker"/>
                <Button text="Search" styleClass="button-open" onAction="#handleSearch"/>
                <Button text="Add Patient" styleClass="button-primary" onAction="#handleAddPatient"/>
            </HBox>
            <Label fx:id="noResultsLabel" visible="false" managed="false" text="No patients found."/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="patientTable">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="220"/>
                <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="150"/>
                <TableColumn fx:id="dobColumn" text="Date of Birth" prefWidth="150"/>
                <TableColumn fx:id="lastVisitColumn" text="Last Appointment" prefWidth="170"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
